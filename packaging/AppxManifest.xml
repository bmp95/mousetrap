<?xml version="1.0" encoding="utf-8"?>
<!-- What makes Mousetrap.exe a Microsoft Store package. The Store signs the package;
     nothing here is secret. Identity and PublisherDisplayName must be the values
     Partner Center shows under "Product identity", and DisplayName the reserved name.
     The build replaces 0.0.0.0 with the version of the exe. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap desktop rescap">

  <Identity Name="bmp95.Mousetrap" Publisher="CN=00000000-0000-0000-0000-000000000000" Version="0.0.0.0" ProcessorArchitecture="neutral" />

  <Properties>
    <DisplayName>Mousetrap</DisplayName>
    <PublisherDisplayName>Bernabé Muñoz Peñas</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="es-es" />
  </Resources>

  <Applications>
    <Application Id="Mousetrap" Executable="Mousetrap.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Mousetrap"
                          Description="Hold both mouse buttons, or a keyboard shortcut, and the lost pointer jumps to the centre of a screen."
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- A package cannot add itself to the registry's startup list; this is how it
             asks Windows to start it at sign-in. The user can switch it off in
             Settings > Apps > Startup. -->
        <desktop:Extension Category="windows.startupTask" Executable="Mousetrap.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="MousetrapStartup" Enabled="true" DisplayName="Mousetrap" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- An ordinary desktop program: it reads the mouse buttons, moves the pointer and
         registers a hot key, none of which a sandboxed app may do. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
